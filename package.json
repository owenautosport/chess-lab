{
  "name": "chess-lab",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:build": "tsc -p electron",
    "app": "npm run build && npm run electron:build && electron .",
    "app:dev": "npm run electron:build && ELECTRON_DEV=1 electron .",
    "dist:mac": "npm run build && npm run electron:build && electron-builder --mac --publish never",
    "install:mac": "bash scripts/install-mac.sh",
    "engines": "node scripts/fetch-engines.mjs",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide": "^1.66.0",
    "stockfish": "^19.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "main": "electron-dist/main.js",
  "build": {
    "appId": "com.owenprice.chesslab",
    "productName": "Chess Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-dist/**",
      "electron/preload.cjs",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.board-games",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "**/*",
          "!*.zip"
        ]
      }
    ],
    "artifactName": "Chess-Lab-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "title": "Chess Lab ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "description": "A free chess trainer: bots that play offline, puzzles, analysis, game review and lessons, with an optional AI coach.",
  "author": "owenautosport"
}
