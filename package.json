{
  "name": "chess-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:build": "tsc -p electron",
    "app": "npm run build && npm run electron:build && electron .",
    "app:dev": "npm run electron:build && ELECTRON_DEV=1 electron .",
    "dist:mac": "npm run build && npm run electron:build && electron-builder --mac dir"
  },
  "devDependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide": "^1.66.0",
    "stockfish": "^19.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "main": "electron-dist/main.js",
  "build": {
    "appId": "com.owenprice.chesslab",
    "productName": "Chess Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-dist/**",
      "electron/preload.cjs",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.board-games",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "engines",
        "to": "engines"
      }
    ]
  }
}
